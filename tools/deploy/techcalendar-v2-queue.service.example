[Unit]
Description=TechCalendar V2 demo queue (separate from V1)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/TechCalendar-v2
ExecStart=/usr/bin/php8.4 artisan queue:work database --queue=default --sleep=2 --tries=1 --timeout=1800 --memory=256
Restart=always
RestartSec=5
TimeoutStopSec=1900
UMask=0077

[Install]
WantedBy=multi-user.target
