APP_NAME="TechCalendar V2 Demo"
APP_ENV=demo
APP_DEBUG=false
APP_URL=https://techcalendar.lucas-dinnichert.fr
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_MAINTENANCE_DRIVER=file
CRM_V2_ENABLED=true
SIMULATION_MODE=true
SIMULATION_ALLOW_EXTERNAL_APIS=true

# APP_KEY and API credentials come from the private demo-secrets.env export.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techcalendar_v2_demo_simulation
DB_USERNAME=techcalendar_v2_demo
DB_URL=
SESSION_DRIVER=database
SESSION_COOKIE=techcalendar_v2_demo_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=techcalendar_v2_demo_
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=1900
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@techcalendar.lucas-dinnichert.fr
MAIL_FROM_NAME="TechCalendar Demo"
LOG_CHANNEL=single
LOG_LEVEL=info

GLOBAL_PLUS_API_URL=https://cee-api.test.globalplus.fr
CAPCEE_ENABLED=false
COFFRAC_API_URL=
COFFRAC_API_TOKEN=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

CRM_COLLECTED_DOCUMENTS_ROOT=/srv/techcalendar-v2-demo/documents
CRM_COLLECTED_DOCUMENTS_MANIFEST=/srv/techcalendar-v2-demo/selection/documents.list0

BROADCAST_CONNECTION=reverb
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
REVERB_ALLOWED_ORIGINS=techcalendar.lucas-dinnichert.fr
VITE_REVERB_HOST=techcalendar.lucas-dinnichert.fr
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
