APP_NAME="Genius Controle"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://cofrac2.geniuscontrole.com
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_MAINTENANCE_DRIVER=file
CRM_V2_ENABLED=true
SIMULATION_MODE=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cofrac2production
DB_USERNAME=cofrac2_app
DB_PASSWORD=__DB_PASSWORD__
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_COOKIE=cofrac2_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=cofrac2_production_
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=1900
FILESYSTEM_DISK=local
LOG_CHANNEL=single
LOG_LEVEL=info

# Preparation only: credentials and live sending are configured separately.
MAIL_MAILER=log
MAIL_DELIVERY_ENABLED=false
MAIL_FROM_ADDRESS=noreply@geniuscontrole.com
MAIL_FROM_NAME="Genius Controle"
SMSFACTOR_ENABLED=false
SMSFACTOR_MODE=simulate
SMSFACTOR_API_TOKEN=
SMSFACTOR_SENDER=Genius
CAPCEE_ENABLED=false
CAPCEE_ENVIRONMENT=uat2
COFFRAC_API_URL=
COFFRAC_API_TOKEN=
GLOBAL_PLUS_API_URL=https://cee-api.test.globalplus.fr
GLOBAL_PLUS_API_KEY=
GLOBAL_PLUS_BUREAU_ID=1035
MAPBOX_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Bind only to loopback. Port availability is checked before starting Reverb.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=cofrac2-production
REVERB_APP_KEY=__REVERB_APP_KEY__
REVERB_APP_SECRET=__REVERB_APP_SECRET__
REVERB_HOST=127.0.0.1
REVERB_PORT=8091
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8091
REVERB_ALLOWED_ORIGINS=cofrac2.geniuscontrole.com
VITE_APP_NAME="Genius Controle"
VITE_REVERB_APP_KEY=__REVERB_APP_KEY__
VITE_REVERB_HOST=cofrac2.geniuscontrole.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
