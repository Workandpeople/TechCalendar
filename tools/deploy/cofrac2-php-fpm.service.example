[Unit]
Description=Cofrac 2 isolated PHP-FPM master
After=network.target mysql.service

[Service]
Type=simple
ExecStart=/usr/sbin/php-fpm8.4 --nodaemonize --fpm-config /etc/cofrac2/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5
RuntimeDirectory=cofrac2
RuntimeDirectoryMode=0755
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/cofrac2 /var/www/cofrac2/storage /var/www/cofrac2/bootstrap/cache
NoNewPrivileges=true
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
