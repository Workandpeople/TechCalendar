# Replacement directives in the EXISTING TechCalendar virtual host.
# Do not add a second server_name, change TLS or replace the entire current vhost.
# Preserve the existing security headers, HTTPS proxy settings and access logs.
root /var/www/TechCalendar-v2/public;
client_max_body_size 1100m;

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

location ^~ /app/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_buffering off;
}

# Only the front controller may execute PHP, never uploaded files.
location = /index.php {
    include snippets/fastcgi-php.conf;
    fastcgi_pass unix:/run/php/techcalendar-v2-demo.sock;
    fastcgi_read_timeout 3900s;
    fastcgi_send_timeout 3900s;
    fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
    include fastcgi_params;
}

location ~ \.php$ {
    return 404;
}

location ~ /\.(?!well-known).* {
    deny all;
}
