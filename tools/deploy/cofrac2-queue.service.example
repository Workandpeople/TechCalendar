[Unit]
Description=Cofrac 2 isolated queue worker
After=network.target mysql.service

[Service]
User=cofrac2-app
Group=cofrac2-app
WorkingDirectory=/var/www/cofrac2
ExecStart=/usr/bin/php8.4 artisan queue:work database --queue=default --sleep=2 --tries=1 --timeout=1800 --memory=256
Restart=always
RestartSec=5
TimeoutStopSec=1900
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/cofrac2/storage /var/www/cofrac2/bootstrap/cache
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
